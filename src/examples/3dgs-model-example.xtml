<!DOCTYPE xtml>
<xtml>
  <head>
    <title>3DGS Model Example</title>
    <meta charset="utf-8">
    <style>
      space {
        background-color: #1a1a1a;
      }
      
      model {
        /* Models can be styled like other elements */
        opacity: 0.9;
        transform: scale(1.0);
      }
      
      .model-container {
        padding: 10px;
        margin: 5px;
      }
    </style>
  </head>
  <space>
    <div class="model-container">
      <h2>Traditional GLTF Model</h2>
      <model src="assets/robot.gltf" autoplay="true"></model>
    </div>
    
    <div class="model-container">
      <h2>3D Gaussian Splatting Model</h2>
      <model src="assets/scene.gsplat" type="3dgs" loading="eager"></model>
    </div>
    
    <div class="model-container">
      <h2>Multiple 3DGS Models (Rendered Together)</h2>
      <model src="assets/object1.ply" type="3dgs"></model>
      <model src="assets/object2.ply" type="3dgs"></model>
      <model src="assets/object3.ply" type="3dgs"></model>
    </div>
  </space>
  
  <script>
    // Wait for the spatial document to be ready
    spatialDocument.addEventListener('spaceReady', () => {
      console.log('Space is ready!');
      
      // Get all model elements
      const models = document.querySelectorAll('model');
      console.log(`Found ${models.length} model elements`);
      
      // Set up event listeners for model loading
      models.forEach((model, index) => {
        console.log(`Model ${index + 1}: ${model.src} (type: ${model.type || 'auto-detect'})`);
        
        // These events will be implemented in future versions
        model.addEventListener('load', () => {
          console.log(`Model loaded: ${model.src}`);
        });
        
        model.addEventListener('error', (event) => {
          console.error(`Failed to load model: ${model.src}`, event.detail);
        });
      });
      
      // Example of programmatically creating a model
      setTimeout(() => {
        const dynamicModel = document.createElement('model');
        dynamicModel.src = 'assets/dynamic.gsplat';
        dynamicModel.type = '3dgs';
        dynamicModel.autoplay = false;
        
        document.querySelector('.model-container:last-child').appendChild(dynamicModel);
        console.log('Added dynamic model element');
      }, 2000);
    });
    
    // Example of handling model interactions
    spatialDocument.addEventListener('click', (event) => {
      if (event.target.tagName === 'MODEL') {
        console.log('Clicked on model:', event.target.src);
        // Could trigger animations, show info, etc.
      }
    });
  </script>
</xtml>