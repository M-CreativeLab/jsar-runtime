  "html": "\n      <html>\n      <head>\n<style>\n background-color:#2e2e2e; flex-direction:column; width:360px; min-height:520px;\n</style>\n<style>\n #moudle0{display:flex; justify-content:flex-end; align-items:center; height:90px; padding:10px; margin-bottom:15px; background-color:#1c1c1c; color:#ffffff; font-size:32px; border-radius:8px;}\n</style>\n<style>\n #moudle1{display:grid; grid-template-columns:repeat(4,1fr); gap:12px; height:calc(100% - 105px); padding-bottom:10px;}\n</style>\n<style>\n #moudle0{display:flex;justify-content:space-around;align-items:center;height:90px;padding:10px;margin-bottom:15px;background-color:#1c1c1c;color:#ffffff;font-size:32px;border-radius:8px;}\n</style>\n<style>\n .grd{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}\n</style>\n<style>\n .b{grid-template-columns:repeat(4,1fr);gap:12px;height:calc(100% - 105px);padding-bottom:10px;display:grid;}\n</style>\n<style>\n .c{background:#f1f1f1;color:#333;border:none;padding:20px 0;font-size:18px;border-radius:8px;cursor:pointer;}\n</style>\n<style>\n .btn{background:#333;color:#fff;border:none;padding:20px;font-size:18px;border-radius:8px;}\n</style>\n<style>\n .btn:hover{background:#555;}\n</style>\n<style>\n .c:hover{background:#ddd;}\n</style>\n<style>\n .c:active{background:#ccc;}\n</style></head>\n      <body style=\"display:flex; justify-content:center; align-items:center;\">\n      <div id=\"app-root\">\n      \n      <div id=\"app-root\">\n        <div id=\"moudle0\" />\n        <div id=\"moudle1\" />\n      </div>\n      <div id=\"帮助我生成一个计算器\">\n        <div id=\"moudle0\" />\n        <div class=\"grd\" id=\"keypad\">\n          <button class=\"btn\" id=\"btn7\">\n            7\n          </button>\n          <button class=\"btn\" id=\"btn8\">\n            8\n          </button>\n          <button class=\"btn\" id=\"btn9\">\n            9\n          </button>\n          <button class=\"btn\" id=\"btnDivide\">\n            ÷\n          </button>\n          <button class=\"btn\" id=\"btn4\">\n            4\n          </button>\n          <button class=\"btn\" id=\"btn5\">\n            5\n          </button>\n          <button class=\"btn\" id=\"btn6\">\n            6\n          </button>\n          <button class=\"btn\" id=\"btnMultiply\">\n            ×\n          </button>\n          <button class=\"btn\" id=\"btn1\">\n            1\n          </button>\n          <button class=\"btn\" id=\"btn2\">\n            2\n          </button>\n          <button class=\"btn\" id=\"btn3\">\n            3\n          </button>\n          <button class=\"btn\" id=\"btnSubtract\">\n            −\n          </button>\n          <button class=\"btn\" id=\"btn0\">\n            0\n          </button>\n          <button class=\"btn\" id=\"btnDecimal\">\n            .\n          </button>\n          <button class=\"btn\" id=\"btnClear\">\n            C\n          </button>\n          <button class=\"btn\" id=\"btnAdd\">\n            +\n          </button>\n          <button class=\"btn\" style=\"background:#007bff;\" id=\"btnEquals\">\n            =\n          </button>\n        </div>\n      </div>\n      </div>\n      </body>\n      </html>\n      "
